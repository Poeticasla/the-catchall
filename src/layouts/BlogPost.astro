---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  heroImage?: any;
  tags?: string[];
  draft?: boolean;
  isCentered?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  isCentered = false,
} = Astro.props;
---

<html lang="id">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header title={title} />

    <main class="container">
      <header
        class:list={[
          "col-md-8 mx-auto border-bottom border-secondary border-opacity-25 mb-4",
          { "text-center": isCentered },
        ]}
      >
        <div class="vstack">
          {
            heroImage && (
              <div class="mb-3">
                <Image
                  width={1020}
                  height={510}
                  src={heroImage}
                  alt={title}
                  class="img-fluid rounded"
                />
              </div>
            )
          }
          {
            pubDate && (
              <div class="d-flex align-items-center flex-wrap gap-3 small mb-2">
                <span class="d-inline-flex align-items-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="me-2"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  <FormattedDate date={pubDate} />
                </span>

                {updatedDate && (
                  <span class="d-inline-flex align-items-center fst-italic">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="me-2"
                    >
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                    Diperbarui: <FormattedDate date={updatedDate} />
                  </span>
                )}
              </div>
            )
          }
          <h1>{title}</h1>
          {description && <p class="lead text-body-secondary">{description}</p>}
        </div>
      </header>

      <div class="col-md-8 mx-auto mt-4">
        <article>
          <slot />
        </article>

        {
          tags.length > 0 && (
            <div class="d-flex flex-wrap gap-2 align-items-center">
              <span>Tags:</span>
              {tags.map((tag) => (
                <a
                  href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                  class="text-decoration-none border-bottom border-primary-subtle"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }

        <button
          id="shareBtn"
          class="btn border-0 p-0 link-body-emphasis d-flex align-items-center gap-2 mt-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          <span id="shareText">Share</span>
        </button>
      </div>
    </main>

    <Footer />
    <script>
      import "../script/main.js";
    </script>
  </body>
</html>
