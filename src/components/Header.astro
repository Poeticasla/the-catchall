---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/Avatar.jpg";
import Breadcrumbs from "../components/Breadcrumbs.astro";
interface Props {
  title?: string;
  category?: string;
}
const { title, category } = Astro.props;
---

<header class="container">
  <div
    class="col-md-8 py-3 mx-auto d-flex align-items-center justify-content-between"
  >
    <Breadcrumbs title={title} category={category} />
    <button
      id="theme-toggle"
      class="ms-auto btn bg-transparent d-flex align-items-center justify-content-center p-0 border-0"
      type="button"
      aria-label="Toggle theme"
      style="width: 40px; height: 40px;"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
        class="sun-icon"
        viewBox="0 0 16 16"
      >
        <path
          d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"
        ></path>
      </svg>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
        class="moon-icon"
        viewBox="0 0 16 16"
      >
        <path
          d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278M4.858 1.311A7.27 7.27 0 0 0 1.025 7.71c0 4.02 3.279 7.276 7.319 7.276a7.32 7.32 0 0 0 5.205-2.162q-.506.063-1.029.063c-4.61 0-8.343-3.714-8.343-8.29 0-1.167.242-2.278.681-3.286"
        ></path>
      </svg>
    </button>
  </div>

  <div class="text-center mb-4">
    <div class="d-inline-block mb-3">
      <a href="/" class="d-block">
        <Image
          src={profileImage}
          alt={SITE_TITLE}
          width={100}
          height={100}
          class="object-fit-cover rounded-circle border border-3 border-body-secondary"
        />
      </a>
    </div>

    <h2 class="fw-bold text-uppercase mb-3" style="letter-spacing: 0.14rem;">
      <a
        href="/"
        class="text-decoration-none link-body-emphasis link-opacity-75-hover"
        >{SITE_TITLE}</a
      >
    </h2>

    <nav class="d-flex justify-content-center flex-wrap gap-3 gap-md-4">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/tags">Tags</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <HeaderLink href="https://github.com/Statiovir">GitHub</HeaderLink>
      <HeaderLink href="https://x.com/Statiovir">Twitter</HeaderLink>
    </nav>
  </div>
</header>

<script>
  import "../script/main.js";
</script>
