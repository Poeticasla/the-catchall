---
import HeaderLink from "./HeaderLink.astro";
const today = new Date();
---

<footer class="container py-4 mt-5">
  <div class="col-md-6 text-center mx-auto">
    <div class="d-flex justify-content-center gap-3 mb-3">
      <HeaderLink href="/privacy">Privacy</HeaderLink>
      <HeaderLink href="/disclaimer">Disclaimer</HeaderLink>
      <HeaderLink href="/rss.xml">RSS Feed</HeaderLink>
    </div>
    <span class="copyright-symbol">&copy;</span>
    {today.getFullYear()}
    <strong>The Catchall</strong>. All rights reserved.
  </div>
</footer>

<style>
  .copyright-symbol {
    font-size: 2rem;
    vertical-align: -0.3em;
    margin-right: 0.1rem;
    line-height: 0;
  }
</style>
